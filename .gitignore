*.env

# Jupyter
.ipynb_checkpoints

# =============================
#       NODE BACKEND
# =============================
backend/node_modules/
backend/dist/
backend/build/

# Backend logs
backend/*.log
backend/logs/
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*

# Backend environment
backend/.env
backend/.env.*

# =============================
#      NODE FRONTEND (React)
# =============================
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.parcel-cache/

# Frontend logs
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Frontend env
frontend/.env
frontend/.env.*

# React/Tailwind/TS cache
frontend/.eslintcache
frontend/.turbo/
frontend/.next/
frontend/.swc/
frontend/*.tsbuildinfo

# =============================
#      GLOBAL AT ROOT
# =============================
.env
.env.*
*.log
logs/

# Optional: ignore lock files if you don’t want them in Git
